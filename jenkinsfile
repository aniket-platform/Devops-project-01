pipeline {
  agent { label 'docker-maven-trivy' }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Debug') {
      steps {
        sh 'pwd'
        sh 'ls -la'
        sh 'which trivy'
        sh 'trivy --version'
      }
    }

    stage('Trivy FS Scan') {
      steps {
        sh 'trivy fs --exit-code 1 --severity HIGH,CRITICAL .'
      }
    }

  }
}
